{% comment %}
  Virtual Try-On Widget - App Embed Block
  Logic lives in assets/vton-widget.js (Shopify 100 KB Liquid limit).
{% endcomment %}

<div id="vton-embed-slot" data-vton-embed-slot style="display:none;width:100%;max-width:100%;margin:16px 0;box-sizing:border-box;" aria-hidden="true"></div>

<script>
  window.VTON_LIQUID = {
    productId: {% if product %}'gid://shopify/Product/{{ product.id }}'{% else %}null{% endif %},
    productHandle: {% if product %}{{ product.handle | json }}{% else %}null{% endif %},
    customAnchor: {{ block.settings.anchor_selector | json }},
    appUrl: {{ block.settings.app_url | default: 'https://vton-production-890a.up.railway.app' | json }},
    pageType: {{ request.page_type | json }},
    templateName: {{ template.name | json }}
  };
</script>

{% schema %}
{
  "name": "Virtual Try-On Widget",
  "target": "body",
  "javascript": "vton-widget.js",
  "settings": [
    {
      "type": "text",
      "id": "anchor_selector",
      "label": "Custom button placement (optional)",
      "info": "CSS selector for button placement on custom themes (e.g. .product-form__buttons). Leave empty for automatic detection + fallback."
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL (fallback API)",
      "default": "https://vton-production-890a.up.railway.app",
      "info": "Only used if App Proxy is unavailable. Normally leave the default."
    }
  ]
}
{% endschema %}
